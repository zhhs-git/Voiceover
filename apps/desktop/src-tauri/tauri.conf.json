{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "有声书生成器",
  "version": "0.1.0",
  "identifier": "local.audiobook.generator",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "有声书生成器",
        "width": 1180,
        "height": 760
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$TEMP/**",
          "$CONFIG/audiobook-generator/books/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}

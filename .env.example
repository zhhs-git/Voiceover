# OpenAI-compatible LLM configuration managed by the web "模型配置" tab.
# Copy to .env only if you want to configure it before opening the web UI.
# Keep the real .env private; it is ignored by Git and written as owner-only.
AUDIOBOOK_LLM_MODEL=provider/model-id
AUDIOBOOK_LLM_BASE_URL=https://api.example.com/v1
AUDIOBOOK_LLM_API_KEY=
